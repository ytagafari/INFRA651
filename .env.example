CRM_WEBHOOK_SECRET=ucs-demo-secret
WEBHOOK_PORT=8080

SEND_EMAIL=1

# Recommended: Google Apps Script Web App (no App Password)
GMAIL_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GMAIL_WEBAPP_SECRET=ucs-email-secret

# Google Drive folder ID (from URL .../folders/THIS_PART) — used for doc links until file IDs are set
GOOGLE_DRIVE_FOLDER_ID=

# Per-file direct links: edit knowledge-base/sheets/Drive-Links.csv (drive_file_id or drive_url)

# Attach matched PDFs to email (from knowledge-base/clients-package/) — no Google Drive needed
ATTACH_PDF_FILES=1
EMAIL_MAX_ATTACHMENTS=4
EMAIL_MAX_ATTACHMENT_BYTES=20000000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@unifiedcloudsensors.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your.email@unifiedcloudsensors.com

# Retrieval: hybrid (default), keyword, or vector
RETRIEVAL_MODE=hybrid
RETRIEVAL_KEYWORD_WEIGHT=0.35
RETRIEVAL_VECTOR_WEIGHT=0.65
# EMBEDDING_MODEL=all-MiniLM-L6-v2
